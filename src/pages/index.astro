      let currentProject = null;
      let currentMediaIndex = 0;

      const sheets = Array.from(document.querySelectorAll(".sheet"));
      const navButtons = Array.from(document.querySelectorAll(".nav-btn"));

      const sections = ["home", "services", "projects", "contact"];

      const sectionToFlipped = {
        home: 0,
        services: 1,
        projects: 1,
        contact: 2,
      };

      const sectionFaceId = {
        home: "face-home",
        services: "face-services",
        projects: "face-projects",
        contact: "face-contact",
      };

      const maxFlipped = 2;

      let flippedCount = 0;
      let desiredFlipped = 0;
      let activeSection = "home";
      let isAnimating = false;

      function getDuration() {
        const value = getComputedStyle(document.documentElement)
          .getPropertyValue("--flip-duration")
          .trim();

        return parseInt(value, 10) || 1000;
      }

      function setNav() {
        navButtons.forEach((button) => {
          button.classList.toggle(
            "active",
            button.dataset.section === activeSection,
          );
        });

        const activeIndex = sections.indexOf(activeSection);
        document.getElementById("prevBtn").disabled = activeIndex <= 0;
        document.getElementById("nextBtn").disabled =
          activeIndex >= sections.length - 1;
      }

      function renderStack() {
        sheets.forEach((sheet, index) => {
          if (index < flippedCount) {
            sheet.classList.add("is-flipped");
            sheet.style.zIndex = 20 + index;
          } else {
            sheet.classList.remove("is-flipped");
            sheet.style.zIndex = 40 - index;
          }
        });
      }

      function pulse(section) {
        const face = document.getElementById(sectionFaceId[section]);
        if (!face) return;

        face.classList.remove("pulse");
        void face.offsetWidth;
        face.classList.add("pulse");

        setTimeout(() => {
          face.classList.remove("pulse");
        }, 1200);
      }

      function animateSheet(sheet, flipClass, onComplete) {
        let finished = false;

        const finish = () => {
          if (finished) return;
          finished = true;
          sheet.classList.remove(flipClass);
          onComplete();
        };

        const handler = (event) => {
          if (event.target !== sheet || event.propertyName !== "transform") {
            return;
          }

          sheet.removeEventListener("transitionend", handler);
          finish();
        };

        sheet.addEventListener("transitionend", handler);
        setTimeout(finish, getDuration() + 180);
      }

      function stepFlip() {
        if (isAnimating) return;

        if (flippedCount === desiredFlipped) {
          pulse(activeSection);
          return;
        }

        if (desiredFlipped > flippedCount) {
          flipForwardStep();
        } else {
          flipBackwardStep();
        }
      }

      function flipForwardStep() {
        if (flippedCount >= sheets.length) return;

        const sheet = sheets[flippedCount];

        isAnimating = true;
        sheet.classList.add("is-flipping-forward");
        sheet.style.zIndex = 80;

        void sheet.offsetWidth;

        sheet.classList.add("is-flipped");

        animateSheet(sheet, "is-flipping-forward", () => {
          flippedCount += 1;
          renderStack();
          isAnimating = false;
          stepFlip();
        });
      }

      function flipBackwardStep() {
        if (flippedCount <= 0) return;

        const sheet = sheets[flippedCount - 1];

        isAnimating = true;
        sheet.classList.add("is-flipping-backward");
        sheet.style.zIndex = 80;

        void sheet.offsetWidth;

        sheet.classList.remove("is-flipped");

        animateSheet(sheet, "is-flipping-backward", () => {
          flippedCount -= 1;
          renderStack();
          isAnimating = false;
          stepFlip();
        });
      }

      function requestFlip(target) {
        desiredFlipped = Math.max(0, Math.min(maxFlipped, target));
        stepFlip();
      }

      const mobileQuery = window.matchMedia("(max-width: 640px)");

function goToSection(section) {
  closeProjectModal();
  activeSection = section;
  setNav();

  if (mobileQuery.matches) {
    const target = document.getElementById(sectionFaceId[section]);
    if (target) {
      target.scrollIntoView({ behavior: "smooth", block: "start" });
    }
    pulse(section);
    return;
  }

  requestFlip(sectionToFlipped[section]);
}

      function nextSection() {
        const index = sections.indexOf(activeSection);
        if (index < sections.length - 1) {
          goToSection(sections[index + 1]);
        }
      }

      function prevSection() {
        const index = sections.indexOf(activeSection);
        if (index > 0) {
          goToSection(sections[index - 1]);
        }
      }

      function renderProjectCards() {
        const list = document.getElementById("projectList");
        if (!list) return;

        list.innerHTML = projects
          .map((project) => {
            const preview = project.media.find((item) => item.type === "image");

            return `
            <button
              onclick="openProject('${project.id}')"
              class="w-full text-left flex items-center gap-4 p-4 rounded-3xl bg-white/[0.05] border border-white/10 hover:border-indigo-500/30 hover:bg-white/[0.08] transition-colors"
            >
              <img
                src="${preview ? preview.src : mediaPlaceholder(project.title)}"
                alt="${project.title} preview"
                class="w-14 h-14 rounded-2xl object-cover border border-white/10 shrink-0"
              />

              <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between gap-3">
                  <h3 class="font-semibold">${project.title}</h3>
                  <span class="text-indigo-200 shrink-0">→</span>
                </div>

                <p class="text-sm text-white/50 mt-1">
                  ${project.summary}
                </p>
              </div>
            </button>
          `;
          })
          .join("");
      }

      function renderMainMedia() {
        const main = document.getElementById("projectMediaMain");
        if (!currentProject || !main) return;

        const media = currentProject.media[currentMediaIndex];

        if (!media) {
          main.innerHTML = `
          <div class="h-full w-full grid place-items-center text-white/35 text-sm">
            No media available
          </div>
        `;
          return;
        }

        if (media.type === "image") {
          main.innerHTML = `
          <img
            src="${media.src}"
            alt="${media.alt || currentProject.title}"
            class="h-full w-full object-cover"
          />
        `;
        } else {
          main.innerHTML = `
          <video
            class="h-full w-full object-contain bg-black"
            controls
            preload="metadata"
            poster="${media.poster || ""}"
          >
            <source src="${media.src}" type="video/mp4" />
            Your browser does not support video playback.
          </video>
        `;
        }
      }

      function renderThumbs() {
        const thumbs = document.getElementById("projectThumbs");
        if (!currentProject || !thumbs) return;

        thumbs.innerHTML = currentProject.media
          .map((media, index) => {
            const isActive = index === currentMediaIndex;
            const preview = media.type === "image" ? media.src : media.poster;

            return `
            <button
              onclick="selectMedia(${index})"
              class="relative aspect-video rounded-2xl overflow-hidden border transition-all ${
                isActive
                  ? "border-indigo-400 ring-2 ring-indigo-400/60"
                  : "border-white/10 hover:border-white/30"
              }"
            >
              <img
                src="${preview || mediaPlaceholder("Media")}"
                alt="Media thumbnail ${index + 1}"
                class="h-full w-full object-cover"
              />

              ${
                media.type === "video"
                  ? `
                    <span class="absolute inset-0 grid place-items-center bg-black/25">
                      <span class="h-8 w-8 rounded-full bg-white/90 text-black grid place-items-center text-xs">
                        ▶
                      </span>
                    </span>
                  `
                  : ""
              }
            </button>
          `;
          })
          .join("");
      }

      function selectMedia(index) {
        currentMediaIndex = index;
        renderMainMedia();
        renderThumbs();
      }

      function openProject(id) {
        const project = projects.find((item) => item.id === id);
        if (!project) return;

        currentProject = project;
        currentMediaIndex = 0;

        document.getElementById("projectCategory").textContent =
          project.category;
        document.getElementById("projectTitle").textContent = project.title;
        document.getElementById("projectDescription").textContent =
          project.description;

        document.getElementById("projectTags").innerHTML = project.tags
          .map((tag) => `<span class="chip">${tag}</span>`)
          .join("");

        const liveLink = document.getElementById("projectLiveLink");
        const repoLink = document.getElementById("projectRepoLink");

        if (project.liveUrl && project.liveUrl !== "#") {
          liveLink.href = project.liveUrl;
          liveLink.classList.remove("hidden");
        } else {
          liveLink.classList.add("hidden");
        }

        if (project.repoUrl && project.repoUrl !== "#") {
          repoLink.href = project.repoUrl;
          repoLink.classList.remove("hidden");
        } else {
          repoLink.classList.add("hidden");
        }

        renderMainMedia();
        renderThumbs();

        const modal = document.getElementById("projectModal");
        const scrollArea = document.getElementById("projectModalScroll");

        modal.classList.add("open");
        modal.setAttribute("aria-hidden", "false");
        scrollArea.scrollTop = 0;
        document.body.style.overflow = "hidden";
      }

      function closeProjectModal() {
        const modal = document.getElementById("projectModal");
        if (!modal.classList.contains("open")) return;

        modal.classList.remove("open");
        modal.setAttribute("aria-hidden", "true");

        document.getElementById("projectMediaMain").innerHTML = "";
        document.body.style.overflow = "";
      }

      navButtons.forEach((button) => {
        button.addEventListener("click", () => {
          goToSection(button.dataset.section);
        });
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeProjectModal();
        }
      });

      window.goToSection = goToSection;
      window.nextSection = nextSection;
      window.prevSection = prevSection;
      window.openProject = openProject;
      window.closeProjectModal = closeProjectModal;
      window.selectMedia = selectMedia;

      renderProjectCards();
      renderStack();
      setNav();
    </script>
  </body>
</html>

    