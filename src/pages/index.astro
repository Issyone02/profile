---
import { projects } from "../data/projects";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Olalere Isaiah | Software Developer &{" "} Automation Engineer</title>

    <style>
      :root {
        --flip-duration: 750ms;
        --flip-ease: cubic-bezier(0.45, 0.05, 0.3, 1);
        --page-alpha: 0.96;
      }

      body {
        background: #05070f;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 120;
        padding: 1rem 1rem 0.55rem;
        background: linear-gradient(
          to bottom,
          rgba(5, 7, 15, 0.96),
          rgba(5, 7, 15, 0.82),
          rgba(5, 7, 15, 0.25)
        );
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
      }

      .scene {
        perspective: 2400px;
      }

      .book-open {
        transform-style: preserve-3d;
      }

      .book-shadow {
        position: absolute;
        left: 8%;
        right: 8%;
        bottom: -30px;
        height: 52px;
        background: radial-gradient(
          50% 50% at 50% 50%,
          rgba(0, 0, 0, 0.52),
          transparent 72%
        );
        filter: blur(18px);
        z-index: 0;
        pointer-events: none;
      }

      .static-left,
      .static-right {
        position: absolute;
        top: 0;
        bottom: 0;
        width: 50%;
      }

      .static-left {
        left: 0;
        z-index: 5;
      }

      .static-right {
        right: 0;
        z-index: 2;
      }

      .page-surface {
        position: absolute;
        inset: 0;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.15);
        box-shadow:
          0 24px 60px rgba(0, 0, 0, 0.34),
          inset 0 1px 0 rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(20px) saturate(1.12);
        -webkit-backdrop-filter: blur(20px) saturate(1.12);
        background:
          radial-gradient(
            120% 120% at 20% 10%,
            rgba(255, 255, 255, 0.07),
            transparent 28%
          ),
          linear-gradient(
            145deg,
            rgba(8, 11, 23, var(--page-alpha)),
            rgba(11, 18, 36, calc(var(--page-alpha) - 0.06))
          );
      }

      .page-left {
        border-radius: 30px 10px 10px 30px;
        border-right: none;
      }

      .page-right {
        border-radius: 10px 30px 30px 10px;
        border-left: none;
      }

      .face-content {
        position: relative;
        z-index: 4;
        height: 100%;
        overflow: auto;
      }

      .gloss {
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        opacity: 0.48;
        background: linear-gradient(
          120deg,
          transparent 0%,
          rgba(255, 255, 255, 0.08) 18%,
          transparent 34%,
          rgba(255, 255, 255, 0.035) 52%,
          transparent 68%,
          rgba(255, 255, 255, 0.05) 88%,
          transparent 100%
        );
      }

      .shade {
        position: absolute;
        inset: 0;
        z-index: 3;
        pointer-events: none;
        opacity: 0;
        background: linear-gradient(
          105deg,
          rgba(0, 0, 0, 0.68) 0%,
          rgba(0, 0, 0, 0.18) 28%,
          rgba(255, 255, 255, 0.08) 50%,
          rgba(0, 0, 0, 0.28) 72%,
          rgba(0, 0, 0, 0.66) 100%
        );
      }

      .center-shadow {
        position: absolute;
        top: 0;
        bottom: 0;
        width: 52px;
        z-index: 2;
        pointer-events: none;
      }

      .page-left .center-shadow {
        right: 0;
        background: linear-gradient(
          to left,
          rgba(0, 0, 0, 0.38),
          rgba(255, 255, 255, 0.03) 28%,
          transparent 78%
        );
      }

      .page-right .center-shadow {
        left: 0;
        background: linear-gradient(
          to right,
          rgba(0, 0, 0, 0.38),
          rgba(255, 255, 255, 0.03) 28%,
          transparent 78%
        );
      }

      .outer-edge {
        position: absolute;
        top: 18px;
        bottom: 18px;
        width: 18px;
        z-index: 2;
        pointer-events: none;
        opacity: 0.35;
        background: repeating-linear-gradient(
          to right,
          rgba(255, 255, 255, 0.14) 0 1px,
          transparent 1px 4px
        );
      }

      .page-left .outer-edge {
        left: 12px;
        -webkit-mask-image: linear-gradient(to left, transparent, black);
        mask-image: linear-gradient(to left, transparent, black);
      }

      .page-right .outer-edge {
        right: 12px;
        -webkit-mask-image: linear-gradient(to right, transparent, black);
        mask-image: linear-gradient(to right, transparent, black);
      }

      .sheet {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 50%;
        width: 50%;
        transform-origin: left center;
        transform-style: preserve-3d;
        transition: transform var(--flip-duration) var(--flip-ease);
        will-change: transform;
      }

      .sheet.is-flipped {
        transform: rotateY(-180deg);
      }

      .sheet.is-flipping-forward,
      .sheet.is-flipping-backward {
        pointer-events: none;
      }

      .sheet-face {
        position: absolute;
        inset: 0;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
        transform-style: preserve-3d;
      }

      .sheet-face.back {
        transform: rotateY(180deg);
      }

      .sheet.is-flipping-forward .front .shade {
        animation: shade-front-forward var(--flip-duration) var(--flip-ease)
          forwards;
      }

      .sheet.is-flipping-forward .back .shade {
        animation: shade-back-forward var(--flip-duration) var(--flip-ease)
          forwards;
      }

      .sheet.is-flipping-backward .front .shade {
        animation: shade-front-backward var(--flip-duration) var(--flip-ease)
          forwards;
      }

      .sheet.is-flipping-backward .back .shade {
        animation: shade-back-backward var(--flip-duration) var(--flip-ease)
          forwards;
      }

      @keyframes shade-front-forward {
        0% {
          opacity: 0;
        }
        45% {
          opacity: 0.34;
        }
        100% {
          opacity: 0.62;
        }
      }

      @keyframes shade-back-forward {
        0% {
          opacity: 0.62;
        }
        55% {
          opacity: 0.22;
        }
        100% {
          opacity: 0;
        }
      }

      @keyframes shade-front-backward {
        0% {
          opacity: 0.62;
        }
        55% {
          opacity: 0.22;
        }
        100% {
          opacity: 0;
        }
      }

      @keyframes shade-back-backward {
        0% {
          opacity: 0;
        }
        45% {
          opacity: 0.34;
        }
        100% {
          opacity: 0.62;
        }
      }

      .book-spine {
        position: absolute;
        left: 50%;
        top: 1.5%;
        bottom: 1.5%;
        width: 58px;
        transform: translateX(-50%);
        z-index: 90;
        pointer-events: none;
        opacity: 0.72;
        filter: blur(2px);
        background: linear-gradient(
          to right,
          transparent 0%,
          rgba(0, 0, 0, 0.34) 34%,
          rgba(0, 0, 0, 0.52) 48%,
          rgba(255, 255, 255, 0.06) 50%,
          rgba(0, 0, 0, 0.52) 52%,
          rgba(0, 0, 0, 0.34) 66%,
          transparent 100%
        );
      }

      .glass-panel {
        background: rgba(8, 11, 23, 0.82);
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
      }

      .nav-btn {
        padding: 0.7rem 1rem;
        border-radius: 9999px;
        color: rgba(255, 255, 255, 0.72);
        transition: all 180ms ease;
        font-size: 0.92rem;
        white-space: nowrap;
      }

      .nav-btn:hover {
        color: white;
        background: rgba(255, 255, 255, 0.08);
      }

      .nav-btn.active {
        color: white;
        background: rgba(255, 255, 255, 0.12);
      }

      .control-btn {
        padding: 0.8rem 1.15rem;
        border-radius: 9999px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(255, 255, 255, 0.08);
        transition: all 180ms ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
      }

      .control-btn:hover:not(:disabled) {
        background: rgba(255, 255, 255, 0.14);
      }

      .control-btn:disabled {
        opacity: 0.35;
        cursor: not-allowed;
      }

      .pulse {
        outline: 2px solid rgba(129, 140, 248, 0.72);
        outline-offset: -2px;
        transition: outline 180ms ease;
      }

      .chip {
        display: inline-flex;
        align-items: center;
        padding: 0.45rem 0.75rem;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.1);
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.72);
        white-space: nowrap;
      }

      .contact-input {
        width: 100%;
        padding: 0.8rem 1rem;
        border-radius: 1.25rem;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: white;
        outline: none;
        transition: all 180ms ease;
        resize: none;
      }

      .contact-input::placeholder {
        color: rgba(255, 255, 255, 0.32);
      }

      .contact-input:focus {
        border-color: rgba(129, 140, 248, 0.55);
        box-shadow: 0 0 0 1px rgba(129, 140, 248, 0.35);
      }

      .project-modal {
        position: fixed;
        inset: 0;
        z-index: 110;
        display: none;
      }

      .project-modal.open {
        display: block;
      }

      .modal-scroll-area {
        position: relative;
        z-index: 10;
        height: 100%;
        overflow-y: auto;
        padding: 7rem 1rem 2.5rem;
      }

      @media (min-width: 768px) {
        .modal-scroll-area {
          padding-top: 6rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        :root {
          --flip-duration: 1ms;
        }
      }

      /* Profile picture hover effect */
      .profile-hover {
        --profile-hover-scale: 1.9;
        position: relative;
        display: inline-block;
        cursor: pointer;
        outline: none;
      }

      .profile-main-wrap {
        position: relative;
        z-index: 3;
        transform-origin: center;
        transition: transform 600ms cubic-bezier(0.2, 0.8, 0.2, 1);
      }

      .profile-main {
        border: 1px solid rgba(255, 255, 255, 0.16);
        box-shadow:
          0 0 0 1px rgba(0, 0, 0, 0.08),
          0 18px 45px rgba(0, 0, 0, 0.38);
        transition:
          box-shadow 600ms ease,
          filter 600ms ease;
      }

      .profile-blur {
        position: absolute;
        inset: 0;
        z-index: 1;
        opacity: 0;
        transform: scale(1);
        filter: blur(22px) saturate(1.15);
        transition:
          opacity 600ms ease,
          transform 600ms cubic-bezier(0.2, 0.8, 0.2, 1);
        pointer-events: none;
        border-radius: 1.75rem;
      }

      .profile-status {
        position: absolute;
        bottom: 6px;
        right: 6px;
        height: 14px;
        width: 14px;
        border-radius: 9999px;
        background: #34d399;
        border: 2px solid #0b1224;
        z-index: 4;
      }

      .profile-hover:hover .profile-main-wrap,
      .profile-hover:focus-visible .profile-main-wrap {
        transform: scale(var(--profile-hover-scale));
      }

      .profile-hover:hover .profile-blur,
      .profile-hover:focus-visible .profile-blur {
        opacity: 0.72;
        transform: scale(calc(var(--profile-hover-scale) + 0.16));
      }

      .profile-hover:hover .profile-main,
      .profile-hover:focus-visible .profile-main {
        box-shadow:
          0 0 0 1px rgba(255, 255, 255, 0.18),
          0 22px 55px rgba(0, 0, 0, 0.38),
          0 0 22px rgba(99, 102, 241, 0.1);
      }

      .profile-hover:focus-visible {
        outline: 2px solid rgba(129, 140, 248, 0.72);
        outline-offset: 8px;
        border-radius: 32px;
      }

      /* Allow the cover image to breathe a little more on larger screens */
      @media (min-width: 768px) {
        .static-left .page-surface,
        .static-left .face-content {
          overflow: visible;
        }
      }

      /* ===== MOBILE: single-page stacked layout ===== */
@media (max-width: 640px) {
  .book-open {
    aspect-ratio: auto !important;
    height: auto !important;
    transform-style: flat !important;
  }

  .book-shadow,
  .book-spine,
  .static-right,
  .center-shadow,
  .outer-edge,
  .sheet[data-sheet="2"] .sheet-face.back {
    display: none !important;
  }

  .static-left,
  .sheet,
  .sheet-face,
  .static-left .page-surface {
    position: relative !important;
    inset: auto !important;
    left: 0 !important;
    width: 100% !important;
    transform: none !important;
  }

  .sheet {
    transition: none !important;
    transform-style: flat !important;
  }

  .sheet-face,
  .static-left .page-surface {
    backface-visibility: visible !important;
    -webkit-backface-visibility: visible !important;
    height: auto !important;
    min-height: 65vh;
    border-radius: 24px !important;
    border: 1px solid rgba(255, 255, 255, 0.15) !important;
    scroll-margin-top: 90px;
  }

  .sheet-face {
    margin-bottom: 1rem;
  }

  .static-left {
    margin-bottom: 1rem;
  }

  .face-content {
    height: auto !important;
    overflow: visible !important;
  }
}

    </style>
  </head>

  <body class="min-h-screen text-white overflow-x-hidden">
    <!-- Decorative background -->
    <div class="pointer-events-none fixed inset-0">
      <div
        class="absolute -top-32 -left-24 h-96 w-96 rounded-full bg-indigo-600/25 blur-[120px]"
      ></div>
      <div
        class="absolute bottom-0 right-0 h-[28rem] w-[28rem] rounded-full bg-emerald-500/15 blur-[140px]"
      ></div>
      <div
        class="absolute top-1/3 left-1/2 h-72 w-72 -translate-x-1/2 rounded-full bg-purple-500/10 blur-[100px]"
      ></div>
    </div>

    <!-- STATIC / STICKY NAVBAR -->
    <header class="site-header">
      <div
        class="max-w-7xl mx-auto glass-panel rounded-3xl px-3 py-3 flex flex-wrap items-center justify-between gap-3"
      >
        <button
          onclick="goToSection('home')"
          class="flex items-center gap-3 px-3 py-2 rounded-2xl hover:bg-white/5 transition-colors"
        >
          <span
            class="w-9 h-9 rounded-xl bg-white/10 border border-white/10 grid place-items-center text-sm font-bold"
          >
            OI
          </span>
          <span class="font-semibold hidden sm:block">Olalere Isaiah</span>
        </button>

        <nav class="flex flex-wrap gap-1">
          <button class="nav-btn active" data-section="home">Home</button>
          <button class="nav-btn" data-section="services">Services</button>
          <button class="nav-btn" data-section="projects">Projects</button>
          <button class="nav-btn" data-section="contact">Contact</button>
        </nav>
      </div>
    </header>

    <main class="relative z-10 px-4 pb-10 pt-3">
      <div class="scene w-full max-w-7xl mx-auto">
        <div class="relative">
          <div class="book-shadow"></div>

          <div
            class="book-open relative aspect-[3/4] sm:aspect-[16/9] lg:aspect-[16/8]"
          >
            <!-- STATIC LEFT PAGE / COVER -->
            <div class="static-left">
              <div class="page-surface page-left">
                <div class="gloss"></div>
                <div class="center-shadow"></div>
                <div class="outer-edge"></div>

                <div
                  class="face-content p-5 md:p-8 flex flex-col justify-between overflow-auto"
                >
                  <div class="flex items-start justify-between gap-4">
                    <div
                      class="w-11 h-11 rounded-2xl bg-white/10 border border-white/10 grid place-items-center text-xl"
                    >
                      ✦
                    </div>

                    <span
                      class="px-3 py-1 rounded-full bg-emerald-400/15 border border-emerald-300/25 text-emerald-200 text-[10px] font-bold uppercase tracking-[0.18em]"
                    >
                      Available
                    </span>
                  </div>

                  <div class="mt-8 md:mt-4">
                    <!-- Display picture with hover expansion -->
                    <div class="mb-5">
                      <div
                        class="profile-hover"
                        tabindex="0"
                        aria-label="Olalere Isaiah profile picture"
                      >
                        <!-- Blurred glow layer -->
                        <img
                          src="profile.jpg"
                          alt=""
                          aria-hidden="true"
                          onerror="
                            this.src =
                              'https://placehold.co/400x400/0b1224/ffffff?text=Olalere+Isaiah'
                          "
                          class="profile-blur h-20 w-20 md:h-24 md:w-24 object-cover object-top"
                        />

                        <!-- Main image -->
                        <div class="profile-main-wrap">
                          <img
                            src="profile.jpg"
                            alt="Olalere Isaiah display picture"
                            onerror="
                              this.src =
                                'https://placehold.co/400x400/0b1224/ffffff?text=Olalere+Isaiah'
                            "
                            class="profile-main h-40 w-40 md:h-40 md:w-40 rounded-[1.75rem] object-cover object-top"
                          />

                          <span class="profile-status"></span>
                        </div>
                      </div>
                    </div>

                    <p
                      class="text-[11px] uppercase tracking-[0.3em] text-white/35 mb-3"
                    >
                      Portfolio Book
                    </p>

                    <h2 class="text-3xl md:text-4xl font-bold leading-tight">
                      Olalere Isaiah
                    </h2>

                    <p class="text-white/55 mt-2">
                      Software Developer & Automation Engineer
                    </p>
                  </div>

                  <div
                    class="p-4 rounded-3xl bg-white/[0.05] border border-white/10"
                  >
                    <p class="text-sm font-semibold text-emerald-200">
                      Open to employment & consulting
                    </p>
                    <p class="text-sm text-white/55 mt-1">
                      Software • Automation • Oil & Gas • Maintenance
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- STATIC RIGHT BASE UNDER SHEETS -->
            <div class="static-right">
              <div class="page-surface page-right">
                <div class="gloss"></div>
                <div class="center-shadow"></div>
                <div class="outer-edge"></div>

                <div class="face-content grid place-items-center p-8">
                  <p class="text-white/25 text-sm text-center">Book base</p>
                </div>
              </div>
            </div>

            <!-- SHEET 1: HOME front / SERVICES back -->
            <div class="sheet" data-sheet="0">
              <div
                class="sheet-face front page-surface page-right"
                id="face-home"
              >
                <div class="gloss"></div>
                <div class="shade"></div>
                <div class="center-shadow"></div>
                <div class="outer-edge"></div>

                <div
                  class="face-content p-5 md:p-8 flex flex-col justify-between overflow-auto"
                >
                  <div class="flex items-start justify-between gap-4">
                    <div
                      class="w-11 h-11 rounded-2xl bg-white/10 border border-white/10 grid place-items-center text-xl"
                    >
                      ✦
                    </div>

                    <span
                      class="px-3 py-1 rounded-full bg-emerald-400/15 border border-emerald-300/25 text-emerald-200 text-[11px] font-bold uppercase tracking-[0.18em]"
                    >
                      Open to Work
                    </span>
                  </div>

                  <div class="mt-8 md:mt-0">
                    <p class="text-sm text-white/50 mb-3">Home</p>

                    <h1
                      class="text-3xl md:text-5xl font-bold leading-[1.04] tracking-tight"
                    >
                      Software Developer & { " "}
                      <span class="text-indigo-200">Automation Engineer</span>
                    </h1>

                    <p class="mt-4 max-w-lg text-white/60">
                      I am Olalere Isaiah — a passionate and intelligent
											professional building web apps, mobile apps, management
                      systems, and industrial automation solutions. I bridge
                      software intelligence with real-world operations.
                    </p>

                    <div class="mt-5 flex flex-wrap gap-2">
                      <span class="chip">Web Apps</span>
                      <span class="chip">Mobile Apps</span>
                      <span class="chip">Management Systems</span>
                      <span class="chip">Industrial Automation</span>
                      <span class="chip">Oil & Gas Support</span>
                    </div>
                  </div>

                  <div class="mt-8 flex flex-wrap gap-3">
                    <button
                      onclick="goToSection('services')"
                      class="px-5 py-3 rounded-2xl bg-white text-slate-950 font-semibold hover:bg-indigo-50 transition-colors"
                    >
                      View Services
                    </button>

                    <button
                      onclick="goToSection('projects')"
                      class="px-5 py-3 rounded-2xl border border-white/15 bg-white/10 hover:bg-white/15 transition-colors"
                    >
                      Projects
                    </button>

                    <button
                      onclick="goToSection('contact')"
                      class="px-5 py-3 rounded-2xl border border-white/15 bg-white/10 hover:bg-white/15 transition-colors"
                    >
                      Contact
                    </button>
                  </div>

                  <div
                    class="mt-6 text-[11px] uppercase tracking-[0.3em] text-white/25"
                  >
                    Page 01
                  </div>
                </div>
              </div>

              <div
                class="sheet-face back page-surface page-left"
                id="face-services"
              >
                <div class="gloss"></div>
                <div class="shade"></div>
                <div class="center-shadow"></div>
                <div class="outer-edge"></div>

                <div
                  class="face-content p-5 md:p-8 flex flex-col overflow-auto"
                >
                  <div class="flex items-end justify-between gap-4 mb-6">
                    <div>
                      <p class="text-sm text-white/50 mb-2">What I offer</p>
                      <h2 class="text-3xl md:text-4xl font-bold tracking-tight">
                        Services
                      </h2>
                    </div>

                    <span
                      class="hidden md:inline-flex px-3 py-1 rounded-full bg-indigo-400/15 border border-indigo-300/25 text-indigo-200 text-[11px] font-bold uppercase tracking-[0.18em]"
                    >
                      Consultation
                    </span>
                  </div>

                  <div class="grid grid-cols-1 xl:grid-cols-2 gap-3">
                    <div
                      class="p-4 rounded-3xl bg-white/[0.05] border border-white/10 hover:bg-white/[0.08] transition-colors"
                    >
                      <div class="text-2xl mb-2">💻</div>
                      <h3 class="font-semibold mb-1">Software Development</h3>
                      <p class="text-sm text-white/55">
                        Web apps, mobile apps, school management systems,
                        library management systems, personal portfolios, and
                        static websites.
                      </p>
                    </div>

                    <div
